{
  "$schema": "https://flagd.dev/schema/v0/flags.json",
  "flags": {
    "client.cache-generation": {
      "state": "ENABLED",
      "variants": { "current": 3 },
      "defaultVariant": "current"
    },
    "client.feature.example": {
      "state": "ENABLED",
      "variants": { "on": true, "off": false },
      "defaultVariant": "off",
      "targeting": {
        "if": [
          {
            "and": [
              { "==": [{ "var": "os" }, "Android"] },
              { "sem_ver": [{ "var": "appVersion" }, ">=", "2.0.0"] }
            ]
          },
          "on",
          "off"
        ]
      }
    },
    "client.feature.not-listed": {
      "state": "ENABLED",
      "variants": { "on": true },
      "defaultVariant": "on"
    }
  }
}

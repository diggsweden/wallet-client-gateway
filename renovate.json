{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "local>diggsweden/.github:renovate-base",
    ":maintainLockFilesWeekly"
  ],
  "enabledManagers": [
    "github-actions",
    "npm",
    "maven",
    "dockerfile",
    "docker-compose",
    "mise"
  ],
  "packageRules": [
    {
      "description": "Maven dependencies - shorten commit message (long groupId:artifactId coordinates push past commit-lint limits)",
      "matchManagers": ["maven"],
      "commitMessageTopic": "{{depName}}"
    },
    {
      "description": "Node.js dependencies - Major updates",
      "matchManagers": ["npm"],
      "matchUpdateTypes": ["major"],
      "addLabels": ["dependencies", "major-update"]
    },
    {
      "description": "Node.js dependencies - Non-major updates",
      "matchManagers": ["npm"],
      "matchUpdateTypes": ["minor", "patch"],
      "addLabels": ["dependencies"],
      "groupName": "npm non-major"
    },
    {
      "description": "Development dependencies",
      "matchManagers": ["npm"],
      "matchDepTypes": ["devDependencies"],
      "groupName": "dev dependencies",
      "addLabels": ["dev-deps"]
    },
    {
      "description": "Maven dependencies - Major updates",
      "matchManagers": ["maven"],
      "matchUpdateTypes": ["major"],
      "addLabels": ["java", "dependencies", "major-update"],
      "groupName": "java major"
    },
    {
      "description": "Maven dependencies - Non-major updates",
      "matchManagers": ["maven"],
      "matchUpdateTypes": ["minor", "patch"],
      "addLabels": ["java", "dependencies"],
      "groupName": "java non-major"
    },
    {
      "description": "Docker images",
      "matchManagers": ["dockerfile", "docker-compose"],
      "addLabels": ["docker", "infrastructure"]
    },
    {
      "description": "wallet-ecosystem action is pinned to a commit for supply-chain safety (not a mutable @main ref). Check for updates on every run instead of only in the weekend schedule window, and require the commit to be at least 1 day old before automerging it - a buffer for something to surface (advisory, revert, CI failure elsewhere) before we adopt it automatically. Automerge is restricted to weekday working hours so a bad merge doesn't land unnoticed overnight or over a weekend.",
      "matchManagers": ["github-actions"],
      "matchPackageNames": ["diggsweden/wallet-ecosystem"],
      "schedule": ["at any time"],
      "minimumReleaseAge": "1 day",
      "automerge": true,
      "automergeSchedule": ["after 8am and before 6pm every weekday"],
      "timezone": "Europe/Stockholm"
    },
    {
      "description": "chainguard/jre is rebuilt roughly weekly, which can make the org default 7-day minimumReleaseAge race the next rebuild indefinitely. Shorten the buffer to 3 days - still a real delay before adopting a new build automatically - and automerge once satisfied, restricted to weekday working hours.",
      "matchManagers": ["dockerfile"],
      "matchPackageNames": ["cgr.dev/chainguard/jre"],
      "schedule": ["at any time"],
      "minimumReleaseAge": "3 days",
      "automerge": true,
      "automergeSchedule": ["after 8am and before 6pm every weekday"],
      "timezone": "Europe/Stockholm"
    },
    {
      "description": "Mise dependencies - Major updates",
      "matchManagers": ["mise"],
      "matchUpdateTypes": ["major"],
      "addLabels": ["dependencies", "major-update"],
      "groupName": "mise major"
    },
    {
      "description": "Mise dependencies - Non-major updates",
      "matchManagers": ["mise"],
      "matchUpdateTypes": ["minor", "patch"],
      "addLabels": ["dependencies"],
      "groupName": "mise non-major"
    }
  ]
}
